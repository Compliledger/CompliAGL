# CompliAGL Backend — Environment Variables
APP_NAME=CompliAGL
APP_VERSION=0.1.0
DEBUG=true
DATABASE_URL=sqlite:///./compliagl.db
SECRET_KEY=change-me-to-a-random-secret

# ── Governance package approval authority ──────────────────────────
# When true, approving a governance package verifies the approver's authority
# against CompliIdentity (governance.package / approve) and fails closed
# otherwise. False = approver principal id + rationale required and recorded
# but not verified.
GOVERNANCE_APPROVAL_AUTHORITY_REQUIRED=false

# ── x402 payment execution adapter ──────────────────────────────────
# Facilitator endpoint used to verify payments. Leave empty or set to
# "mock" to use the built-in mock facilitator during local development.
X402_FACILITATOR_URL=
# Address that should receive the x402 payment.
X402_RECIPIENT_ADDRESS=
# Price (in USDC) required to authorise an autonomous action.
X402_PRICE_USDC=0.0
# Network the payment is expected to settle on.
X402_NETWORK=base-sepolia
# Force the built-in mock facilitator (no external services/secrets). Set to
# false to use a real X402_FACILITATOR_URL.
X402_MOCK_MODE=true

# ── Execution authorization signing ─────────────────────────────────
# Private keys for signing ExecutionAuthorization resources. Supply as a JSON
# object mapping signer key IDs to secret key material, e.g.
#   AUTHORIZATION_SIGNING_KEYS={"auth-key-2026":"<base64-or-hex-secret>"}
# Keys MUST be provided through environment-backed secret management and never
# committed to source control. When left empty a deterministic development key
# is derived from SECRET_KEY so authorizations are always signed locally.
AUTHORIZATION_SIGNING_KEYS=
# Signer key ID (a key from AUTHORIZATION_SIGNING_KEYS) used to sign new
# authorizations. Defaults to the derived development key when empty.
AUTHORIZATION_ACTIVE_SIGNER_KEY_ID=
# Default authorization lifetime, in seconds (used when no explicit expiry is
# supplied at issue time).
AUTHORIZATION_DEFAULT_TTL_SECONDS=900

# ── Escalation-approval orchestration ──────────────────────────────
# Default lifetime, in seconds, of a human approval of an ESCALATED decision
# when no explicit valid_until is supplied at submit time.
ESCALATION_APPROVAL_TTL_SECONDS=900
