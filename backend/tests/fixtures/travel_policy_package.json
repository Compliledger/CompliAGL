  ],
  "requirements": [
    {
      "requirement_id": "REQ-1",
      "source_reference": "TRAVEL-POLICY-2024 §1",
      "normalized_text": "Employees may book domestic economy travel on approved airlines.",
      "requirement_type": "travel_booking",
      "classification": "PERMISSION",
      "applicability_expression": "is_international == False and cabin_class == 'ECONOMY'",
      "mapped_control_ids": ["CTL-1"],
      "severity": "MEDIUM"
    },
    {
      "requirement_id": "REQ-2",
      "source_reference": "TRAVEL-POLICY-2024 §2",
      "normalized_text": "The total fare may not exceed $750 without manager approval.",
      "requirement_type": "spend_limit",
      "classification": "OBLIGATION",
      "applicability_expression": "fare_minor > 75000",
      "mapped_control_ids": ["CTL-2"],
      "severity": "HIGH"
    },
    {
      "requirement_id": "REQ-3",
      "source_reference": "TRAVEL-POLICY-2024 §3",
      "normalized_text": "International travel requires prior authorization.",
      "requirement_type": "authorization",
      "classification": "OBLIGATION",
      "applicability_expression": "is_international == True",
      "mapped_control_ids": ["CTL-3"],
      "severity": "HIGH"
    },
    {
      "requirement_id": "REQ-4",
      "source_reference": "TRAVEL-POLICY-2024 §4",
      "normalized_text": "Airlines not included in the approved vendor list are prohibited.",
      "requirement_type": "vendor_restriction",
      "classification": "PROHIBITION",
      "applicability_expression": "airline not in approved_airlines",
      "mapped_control_ids": ["CTL-4"],
      "severity": "CRITICAL"
    },
    {
      "requirement_id": "REQ-5",
      "source_reference": "TRAVEL-POLICY-2024 §5",
      "normalized_text": "Travel must originate from and arrive at approved locations.",
      "requirement_type": "location_restriction",
      "classification": "OBLIGATION",
      "applicability_expression": "origin in approved_locations and destination in approved_locations",
      "mapped_control_ids": ["CTL-5"],
      "severity": "HIGH"
    }
  ],
  "applicability_rules": [
    {
      "rule_id": "APP-1",
      "description": "Applies to employee-initiated travel booking intents.",
      "expression": "intent_type == 'WORKFLOW_ACTION' and action == 'book_travel'"
    }
  ],
  "control_definitions": [
    {
      "control_id": "CTL-1",
      "requirement_ids": ["REQ-1"],
      "control_objective": "Permit domestic economy travel on approved airlines.",
      "evaluation_expression": "is_international == False and cabin_class == 'ECONOMY' and airline in approved_airlines",
      "mandatory": true,
      "severity": "MEDIUM",
      "failure_disposition": "DENY",
      "remediation_eligible": false,
      "evidence_requirement_ids": ["EV-1"],
      "decision_impact": {"on_fail": "DENIED", "reason_code": "TRAVEL_NOT_PERMITTED"}
    },
    {
      "control_id": "CTL-2",
      "requirement_ids": ["REQ-2"],
      "control_objective": "Enforce the $750 fare cap unless a manager approves.",
      "evaluation_expression": "fare_minor <= 75000 or manager_approval == True",
      "mandatory": true,
      "severity": "HIGH",
      "failure_disposition": "ESCALATE",
      "remediation_eligible": true,
      "evidence_requirement_ids": ["EV-2"],
      "decision_impact": {"on_fail": "ESCALATED", "reason_code": "FARE_EXCEEDS_LIMIT_REQUIRES_APPROVAL"}
    },
    {
      "control_id": "CTL-3",
      "requirement_ids": ["REQ-3"],
      "control_objective": "Require prior authorization for international travel.",
      "evaluation_expression": "is_international == False or prior_authorization == True",
      "mandatory": true,
      "severity": "HIGH",
      "failure_disposition": "ESCALATE",
      "remediation_eligible": true,
      "evidence_requirement_ids": ["EV-3"],
      "decision_impact": {"on_fail": "ESCALATED", "reason_code": "INTERNATIONAL_REQUIRES_AUTHORIZATION"}
    },
    {
      "control_id": "CTL-4",
      "requirement_ids": ["REQ-4"],
      "control_objective": "Prohibit airlines outside the approved vendor list.",
      "evaluation_expression": "airline in approved_airlines",
      "mandatory": true,
      "severity": "CRITICAL",
      "failure_disposition": "DENY",
      "remediation_eligible": false,
      "evidence_requirement_ids": ["EV-1"],
      "decision_impact": {"on_fail": "DENIED", "reason_code": "AIRLINE_NOT_APPROVED"}
    },
    {
      "control_id": "CTL-5",
      "requirement_ids": ["REQ-5"],
      "control_objective": "Restrict travel to approved origin and destination locations.",
      "evaluation_expression": "origin in approved_locations and destination in approved_locations",
      "mandatory": true,
      "severity": "HIGH",
      "failure_disposition": "DENY",
      "remediation_eligible": false,
      "evidence_requirement_ids": ["EV-4"],
      "decision_impact": {"on_fail": "DENIED", "reason_code": "LOCATION_NOT_APPROVED"}
    }
  ],
