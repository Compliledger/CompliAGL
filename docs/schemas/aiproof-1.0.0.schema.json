        "SIGNED",
        "SUBMITTED_TO_COMPLILEDGER",
        "ACCEPTED_BY_COMPLILEDGER",
        "REJECTED_BY_COMPLILEDGER",
        "SUPERSEDED",
        "REVOKED"
      ],
      "title": "AIProofStatus",
      "type": "string"
    },
